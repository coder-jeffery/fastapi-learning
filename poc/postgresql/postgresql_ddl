SELECT
    u.name AS 用户名,
    a.title AS 文章标题,
    a.create_time AS 发布时间
FROM users u  -- 别名 u，简化写法
INNER JOIN articles a ON u.id = a.user_id;  -- 关联条件：用户id = 文章所属用户id



SELECT
    u.name AS 用户名,
    a.title AS 文章标题,
    a.create_time AS 发布时间
FROM users u  -- 别名 u，简化写法
INNER JOIN articles a
ON u.id = a.user_id;  -- 关联条件：用户id = 文章所属用户id


-- 全连接查询
SELECT
    COALESCE(u.name, '无作者') AS 用户名,
    COALESCE(a.title, '无文章') AS 文章标题
FROM users u
FULL JOIN articles a ON u.id = a.user_id;