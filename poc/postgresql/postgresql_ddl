\c system_db

drop table users;

-- 1. 用户表（主表）
CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    age INT
);

-- 2. 文章表（关联用户表，外键 user_id）
CREATE TABLE articles (
    id SERIAL PRIMARY KEY,
    title VARCHAR(100) NOT NULL,
    content TEXT,
    user_id INT REFERENCES users(id) ON DELETE CASCADE,  -- 外键关联用户
    create_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. 评论表（关联文章表，外键 article_id）
CREATE TABLE comments (
    id SERIAL PRIMARY KEY,
    content TEXT NOT NULL,
    article_id INT REFERENCES articles(id) ON DELETE CASCADE,  -- 外键关联文章
    user_name VARCHAR(50),
    create_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

